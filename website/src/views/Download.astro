---
import Base from '../layouts/Base.astro';
import DownloadPanel from '../components/DownloadPanel.astro';
import { strings, GITHUB } from '../i18n.mjs';
import { getRelease } from '../lib/release-data.mjs';
import { PETS } from '../data/pets.mjs';

interface Props { locale: 'zh' | 'en' }
const { locale } = Astro.props;
const t = strings[locale].download;
const release = await getRelease();
const file = release.apk.name;
---
<Base locale={locale} path="/download/" title={`${t.pageTitle} · Infinity Deck`} description={t.pageDescription} current="download">
  <div class="wrap page">
    <DownloadPanel locale={locale} release={release} heading="h1" />

    <div class="dl-page prose">
      <section>
        <h2>{t.stepsTitle}</h2>
        <ol class="steps">{t.steps.map(s => <li>{s}</li>)}</ol>
      </section>
      <section id="pets">
        <h2>{t.petsTitle}</h2>
        <p>{t.petsBody}</p>
        <ul class="pets">
          {PETS.map(p => (
            <li>
              <img src={`/pets/${p.thumb}`} alt="" width="96" height="96" loading="lazy" decoding="async">
              <div class="pet-b">
                <b>{p.name}</b>
                <dl>
                  <dt>{t.petVersion}</dt><dd>{p.version}</dd>
                  <dt>{t.petSize}</dt><dd>{(p.size / 1048576).toFixed(1)} MB</dd>
                  <dt>{t.petLicense}</dt><dd>{t.petLicenseValue}</dd>
                  <dt>SHA-256</dt><dd><code>{p.sha256}</code></dd>
                </dl>
                <a class="btn btn-ghost btn-sm" href={`/pets/${p.file}`} download={p.file}>{t.petDownload}</a>
              </div>
            </li>
          ))}
        </ul>
      </section>
      <section>
        <h2>{t.verifyTitle}</h2>
        <p>{t.verifyHint}</p>
        <div class="verify">
          <div><span>macOS</span><pre>shasum -a 256 {file}</pre></div>
          <div><span>Linux</span><pre>sha256sum {file}</pre></div>
          <div><span>Windows</span><pre>certutil -hashfile {file} SHA256</pre></div>
        </div>
      </section>
      <section>
        <h2>{t.linuxTitle}</h2>
        <p>{t.linuxBody}</p>
      </section>
      <section>
        <h2>{t.upgradeTitle}</h2>
        <p>{t.upgradeBody} <a href={`${GITHUB}/blob/main/docs/guide/install-and-upgrade.md`}>{t.upgradeLink}</a></p>
      </section>
    </div>
  </div>
</Base>
