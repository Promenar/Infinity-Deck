---
// 下载台：版本、APK 按钮、SHA-256 与平台状态。首页与下载页共用。
import { strings, href } from '../i18n.mjs';
import { formatSize, formatDate, RELEASES_URL } from '../lib/release.mjs';

interface Props { locale: 'zh' | 'en'; release: any; heading: 'h1' | 'h2'; showPageLink?: boolean }
const { locale, release, heading: Heading, showPageLink = false } = Astro.props;
const t = strings[locale].download;
---
<div class="dl" data-release={release.tag}>
  <div class="icon-orb"><img src="/icon.png" alt="" width="220" height="220"></div>
  <div>
    <Heading class="sweep" data-sweep>{t.title}</Heading>
    <p class="ver">
      {locale === 'zh'
        ? <Fragment><b data-version>{release.tag}</b>，<span class="nw"><span data-date>{formatDate(release.publishedAt, locale)}</span>{t.released}</span></Fragment>
        : <Fragment><b data-version>{release.tag}</b>, <span class="nw">{`${t.released} `}<span data-date>{formatDate(release.publishedAt, locale)}</span></span></Fragment>}
      <a class="newer" href={RELEASES_URL} data-newer hidden>{t.newer}</a>
    </p>
    <div class="cta">
      <a class="btn btn-primary" href={release.apk.url} data-apk>{t.apk} <small data-size>{formatSize(release.apk.size)}</small></a>
      <a class="btn btn-ghost" href={showPageLink ? href(locale, '/download/') : RELEASES_URL}>{showPageLink ? strings[locale].download.stepsTitle : t.all}</a>
    </div>
    <div class="sha" data-sha-row data-sha-file={t.shaFile}>
      <span class="sha-l">{t.shaLabel}</span>
      <code data-sha>{release.sha256}</code>
      <button class="btn btn-ghost btn-sm" type="button" data-copy data-copied={t.copied} data-selected={t.selected}>{t.copy}</button>
    </div>
    <div class="reqs">{t.reqs.map(r => <span>{r}</span>)}</div>
    <div class="soon">
      <div class="platform live"><b>{t.platforms.android}</b><span>{t.available}</span></div>
      <div class="platform"><b>{t.platforms.macos}</b><span>{t.soon}</span></div>
    </div>
  </div>
</div>

<script>
  import '../scripts/download.ts';
</script>
